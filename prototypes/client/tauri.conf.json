{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AW2 Client Prototype",
  "version": "0.1.0",
  "identifier": "org.aw2lab.client-prototype",
  "build": { "frontendDist": "web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "AW2 Lab · Match viewer", "width": 1200, "height": 850 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:43127"
    }
  },
  "bundle": { "active": false }
}
