+void mScriptContextPollBridge(struct mScriptContext* context) {
+	struct mScriptCoreAdapter* adapter = _getAdapter(context);
+	if (!adapter || adapter->bridgePolling || adapter->bridgeFrames) {
+		return;
+	}
+	adapter->bridgePolling = true;
+	mScriptContextTriggerCallback(context, "bridgePoll", NULL);
+	adapter->bridgePolling = false;
+	if (!adapter->bridgeFrames) {
+		return;
+	}
+	struct mCore* core = adapter->core;
+	core->setKeys(core, adapter->bridgeKeys);
+	uint32_t i;
+	for (i = 0; i < adapter->bridgeFrames; ++i) {
+		core->runFrame(core);
+	}
+	if (adapter->bridgeReleaseKeys) {
+		core->setKeys(core, 0);
+	}
+	adapter->bridgeFrames = 0;
+	mScriptContextTriggerCallback(context, "bridgeComplete", NULL);
+}
