Load command-line scripts without opening the graphical scripting console by
default. AW2_MGBA_SCRIPTING_CONSOLE=1 opens it for interactive debugging.

diff --git a/src/platform/qt/Window.cpp b/src/platform/qt/Window.cpp
--- a/src/platform/qt/Window.cpp
+++ b/src/platform/qt/Window.cpp
@@ -8,1 +8,2 @@
 #include <QKeyEvent>
+#include <mgba/core/log.h>
@@ -2352,7 +2352,17 @@
 	if (!m_scripting) {
 		QStringList scripts = m_config->getArgvOption("script").toStringList();
 		if (!scripts.isEmpty()) {
+			mLOG(
+			    STATUS, INFO,
+			    "AW2 mGBA patches: mgba-frame-gate.patch=%s; "
+			    "mgba-quiet-script-startup.patch=enabled; scripting console=%s",
+			    qEnvironmentVariable("AW2_MGBA_FRAME_GATE") == "1" ? "enabled" : "disabled",
+			    qEnvironmentVariable("AW2_MGBA_SCRIPTING_CONSOLE") == "1" ? "shown" : "hidden");
-			scriptingOpen();
+			if (qEnvironmentVariable("AW2_MGBA_SCRIPTING_CONSOLE") == "1") {
+				scriptingOpen();
+			} else {
+				ensureScripting();
+			}
 			for (const auto& scriptPath : scripts) {
 				m_scripting->loadFile(scriptPath);
 			}
